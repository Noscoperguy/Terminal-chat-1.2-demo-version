<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Terminal 1.3 DEMO</title>
    <style>
        /* --- БАЗОВЫЕ СТИЛИ (как в v1.2) --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
        }
        body {
            font-family: 'Courier New', Courier, monospace;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 15px;
            background-color: #f0f0f0;
        }
        body.dark-theme {
            background-color: #0a0a0a;
        }
        body.dark-theme .terminal {
            background-color: #111111;
            border-color: #00ff41;
            box-shadow: 0 0 30px rgba(0, 255, 65, 0.2);
        }
        body.dark-theme .header {
            border-bottom-color: #00ff41;
            color: #00ff41;
        }
        body.dark-theme #counter {
            color: #00ff41;
        }
        body.dark-theme .messages {
            background: #0a0a0a;
        }
        body.dark-theme .message {
            background: #111111;
            border-left-color: #00ff41;
        }
        body.dark-theme .message .nick {
            color: #00ff41;
        }
        body.dark-theme .message .text {
            color: #e0e0e0;
        }
        body.dark-theme .message .time {
            color: #555555;
        }
        body.dark-theme .input-area {
            border-top-color: #00ff41;
        }
        body.dark-theme .input-row input {
            background: #1a1a1a;
            border-color: #00ff41;
            color: #00ff41;
        }
        body.dark-theme .input-row input:focus {
            background: #000000;
            box-shadow: 0 0 10px rgba(0, 255, 65, 0.3);
        }
        body.dark-theme #sendBtn {
            background: #00ff41;
            color: #000000;
        }
        body.dark-theme #sendBtn:hover {
            background: #ffffff;
            box-shadow: 0 0 20px #00ff41;
        }
        body.dark-theme .hint {
            color: #444444;
        }
        body.dark-theme .admin-btn {
            border-color: #00ff41;
            color: #00ff41;
        }
        body.dark-theme .admin-btn:hover {
            background: #00ff41;
            color: #000000;
        }
        body.dark-theme .admin-btn.active {
            background: #00ff41;
            color: #000000;
        }
        body.dark-theme .delete-btn {
            color: #ff4444;
        }
        body.dark-theme .modal-content {
            background: #1a1a1a;
            border-color: #00ff41;
            color: #00ff41;
        }
        body.dark-theme .modal-content input {
            background: #000;
            border-color: #00ff41;
            color: #00ff41;
        }
        body.dark-theme .modal-content button {
            background: #00ff41;
            color: #000;
        }
        body.dark-theme .modal-content .close-modal {
            background: #444;
            color: #fff;
        }
        body.dark-theme .theme-toggle {
            color: #00ff41;
        }
        body:not(.dark-theme) {
            background-color: #f0f0f0;
        }
        body:not(.dark-theme) .terminal {
            background-color: #ffffff;
            border-color: #ff4500;
            box-shadow: 0 0 40px rgba(255, 69, 0, 0.2);
        }
        body:not(.dark-theme) .header {
            border-bottom-color: #ff4500;
            color: #ff4500;
        }
        body:not(.dark-theme) #counter {
            color: #ff4500;
        }
        body:not(.dark-theme) .messages {
            background: #fafafa;
        }
        body:not(.dark-theme) .message {
            background: #ffffff;
            border-left-color: #ff4500;
        }
        body:not(.dark-theme) .message .nick {
            color: #ff4500;
        }
        body:not(.dark-theme) .message .text {
            color: #000000;
        }
        body:not(.dark-theme) .input-area {
            border-top-color: #ff4500;
        }
        body:not(.dark-theme) .input-row input {
            background: #fff;
            border-color: #ccc;
            color: #000;
        }
        body:not(.dark-theme) .input-row input:focus {
            border-color: #ff4500;
        }
        body:not(.dark-theme) #sendBtn {
            background: #ff4500;
            color: #fff;
        }
        body:not(.dark-theme) #sendBtn:hover {
            background: #cc3700;
        }
        body:not(.dark-theme) .theme-toggle {
            color: #ff4500;
        }
        .terminal {
            width: 100%;
            max-width: 900px;
            height: 92vh;
            max-height: 800px;
            display: flex;
            flex-direction: column;
            padding: 15px 20px;
            border-radius: 12px;
            position: relative;
            border-width: 3px;
            border-style: solid;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 10px;
            margin-bottom: 15px;
            border-bottom-width: 2px;
            border-bottom-style: solid;
            flex-wrap: wrap;
            gap: 8px;
            font-weight: bold;
            font-size: 15px;
        }
        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .header-left span:first-child {
            font-size: 18px;
        }
        .header-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .theme-toggle {
            background: none;
            border: none;
            font-size: 22px;
            cursor: pointer;
            padding: 0 8px;
            transition: 0.2s;
            line-height: 1;
        }
        .theme-toggle:hover {
            transform: scale(1.2);
        }
        .messages {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 12px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            scroll-behavior: smooth;
        }
        .messages::-webkit-scrollbar {
            width: 6px;
        }
        .messages::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.05);
        }
        .messages::-webkit-scrollbar-thumb {
            border-radius: 4px;
            background: #888;
        }
        body.dark-theme .messages::-webkit-scrollbar-thumb {
            background: #00ff41;
        }
        .message {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 6px 12px;
            border-radius: 4px;
            border-left-width: 4px;
            border-left-style: solid;
            word-wrap: break-word;
            animation: fadeIn 0.15s ease-in;
        }
        @keyframes fadeIn {
            0% {
                opacity: 0.5;
                transform: translateX(-8px);
            }
            100% {
                opacity: 1;
                transform: translateX(0);
            }
        }
        .message-content {
            flex: 1;
        }
        .message .nick {
            font-weight: bold;
        }
        .message .nick::before {
            content: "[";
        }
        .message .nick::after {
            content: "] ";
        }
        .message .time {
            font-size: 11px;
            margin-right: 10px;
            opacity: 0.7;
        }
        .message .text {
            word-break: break-word;
        }
        .delete-btn {
            background: none;
            border: none;
            font-size: 16px;
            cursor: pointer;
            padding: 0 6px;
            opacity: 0;
            transition: 0.2s;
            flex-shrink: 0;
        }
        .message:hover .delete-btn {
            opacity: 0.6;
        }
        .delete-btn:hover {
            opacity: 1 !important;
            transform: scale(1.3);
        }
        @media (max-width: 600px) {
            .delete-btn {
                opacity: 0.5;
            }
        }
        .input-area {
            border-top-width: 2px;
            border-top-style: solid;
            padding-top: 12px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .input-row {
            display: flex;
            gap: 8px;
        }
        .input-row input {
            padding: 10px 12px;
            font-family: 'Courier New', monospace;
            font-size: 14px;
            border-width: 2px;
            border-style: solid;
            border-radius: 6px;
            outline: none;
            width: 100%;
        }
        #nickInput {
            width: 25%;
            min-width: 80px;
        }
        #msgInput {
            flex: 1;
        }
        #sendBtn {
            padding: 10px 20px;
            font-family: 'Courier New', monospace;
            font-weight: bold;
            font-size: 14px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: 0.2s;
            white-space: nowrap;
        }
        #sendBtn:active {
            transform: scale(0.95);
        }
        .hint {
            font-size: 11px;
            text-align: center;
            opacity: 0.6;
        }
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.2s;
        }
        .modal-content {
            padding: 30px;
            border-radius: 12px;
            border-width: 3px;
            border-style: solid;
            max-width: 380px;
            width: 92%;
            text-align: center;
        }
        .modal-content h2 {
            margin-bottom: 15px;
        }
        .modal-content input {
            width: 100%;
            padding: 12px;
            border-radius: 6px;
            border-width: 2px;
            border-style: solid;
            font-size: 16px;
            margin-bottom: 15px;
            outline: none;
            font-family: 'Courier New', monospace;
        }
        .modal-content button {
            padding: 10px 30px;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            cursor: pointer;
            font-family: 'Courier New', monospace;
            font-weight: bold;
            margin: 4px;
        }
        .modal-content .close-modal {
            background: #888;
            color: #fff;
        }
        #internet-warning {
            display: none;
            background-color: #ff0000;
            color: #ffffff;
            text-align: center;
            padding: 8px 12px;
            font-size: 14px;
            font-weight: bold;
            border-radius: 6px;
            margin-top: 8px;
            animation: fadeIn 0.3s;
            letter-spacing: 1px;
        }
        #internet-warning.show {
            display: block;
        }
        /* Стиль для правил */
        .rules-box {
            background: rgba(255, 69, 0, 0.1);
            border: 2px solid #ff4500;
            border-radius: 8px;
            padding: 12px 16px;
            margin-bottom: 10px;
            font-size: 13px;
            color: #333;
        }
        body.dark-theme .rules-box {
            background: rgba(0, 255, 65, 0.1);
            border-color: #00ff41;
            color: #ccc;
        }
        .rules-box h4 {
            color: #ff4500;
            margin-bottom: 6px;
        }
        body.dark-theme .rules-box h4 {
            color: #00ff41;
        }
        .rules-box ul {
            padding-left: 20px;
            margin: 4px 0;
        }
        .rules-box ul li {
            margin: 2px 0;
        }
        /* История версий */
        .version-history {
            background: rgba(0, 0, 0, 0.05);
            border-radius: 8px;
            padding: 8px 12px;
            margin-bottom: 10px;
            font-size: 12px;
            color: #555;
            border-left: 3px solid #ff4500;
        }
        body.dark-theme .version-history {
            background: rgba(255, 255, 255, 0.05);
            border-left-color: #00ff41;
            color: #aaa;
        }
        .version-history strong {
            color: #ff4500;
        }
        body.dark-theme .version-history strong {
            color: #00ff41;
        }
        @media (max-width: 600px) {
            .terminal {
                height: 95vh;
                max-height: 100vh;
                padding: 12px 14px;
            }
            .header {
                font-size: 13px;
            }
            .header-left span:first-child {
                font-size: 15px;
            }
            .input-row {
                flex-wrap: wrap;
            }
            #nickInput {
                width: 100%;
                min-width: unset;
            }
            #sendBtn {
                width: 100%;
                justify-content: center;
                padding: 12px;
            }
            .modal-content {
                padding: 20px;
            }
        }
        @media (max-width: 400px) {
            .header-right .admin-btn {
                font-size: 10px;
                padding: 4px 10px;
            }
            .theme-toggle {
                font-size: 18px;
            }
        }
    </style>
</head>
<body>

    <div class="terminal">
        <!-- ШАПКА -->
        <div class="header">
            <div class="header-left">
                <span>💻 TERMINAL v1.3</span>
                <span id="counter">0 сообщений</span>
            </div>
            <div class="header-right">
                <button class="theme-toggle" id="themeToggle" title="Сменить тему">🌙</button>
                <button class="admin-btn" id="adminToggleBtn">🔑 Админ</button>
            </div>
        </div>

        <!-- ОКНО СООБЩЕНИЙ -->
        <div class="messages" id="messageContainer">
            <!-- Блок истории версий -->
            <div class="version-history" id="versionHistory">
                <strong>📜 История версий:</strong><br>
                <strong>v1.0</strong> — Первый запуск (тёмный терминал, локальные сообщения)<br>
                <strong>v1.2 DEMO</strong> — Добавлены темы, админка, проверка интернета<br>
                <strong>v1.3 DEMO</strong> — 🔥 Добавлены: система банов (мьют), правила чата, окошко истории
            </div>
            <!-- Блок правил (появится после первого сообщения админа) -->
            <div id="rulesContainer" style="display:none;"></div>
        </div>

        <!-- Уведомление об интернете -->
        <div id="internet-warning">❌ Нет подключения к интернету. Сообщения сохранятся локально.</div>

        <!-- ВВОД -->
        <div class="input-area">
            <div class="input-row">
                <input type="text" id="nickInput" placeholder="Ник" value="Аноним" maxlength="20">
                <input type="text" id="msgInput" placeholder="Напиши сообщение..." autofocus>
                <button id="sendBtn">➤ ОТПРАВИТЬ</button>
            </div>
            <div class="hint">[ v1.3 DEMO ] — Админ может удалять, выдавать мьют и устанавливать правила</div>
        </div>
    </div>

    <!-- МОДАЛКА АДМИНА -->
    <div class="modal" id="adminModal">
        <div class="modal-content">
            <h2>🔑 Вход для админа</h2>
            <p style="margin-bottom: 15px; opacity: 0.7;">Введите пароль для управления чатом</p>
            <input type="password" id="adminPassword" placeholder="Пароль">
            <div>
                <button id="adminLoginBtn">Войти</button>
                <button class="close-modal" id="adminModalClose">Отмена</button>
            </div>
        </div>
    </div>

    <!-- МОДАЛКА ДЛЯ МЬЮТА -->
    <div class="modal" id="muteModal">
        <div class="modal-content">
            <h2>🔇 Выдать мьют</h2>
            <p style="margin-bottom: 15px; opacity: 0.7;">Введите ник пользователя, которого нужно забанить</p>
            <input type="text" id="muteInput" placeholder="Ник пользователя">
            <div>
                <button id="muteConfirmBtn">🔇 Забанить</button>
                <button class="close-modal" id="muteModalClose">Отмена</button>
            </div>
            <p style="margin-top: 10px; font-size: 12px; opacity:0.6;">Забаненный не сможет писать сообщения.</p>
        </div>
    </div>

    <script>
        // ==========================================
        // 1. ПЕРЕМЕННЫЕ
        // ==========================================
        const messageContainer = document.getElementById('messageContainer');
        const nickInput = document.getElementById('nickInput');
        const msgInput = document.getElementById('msgInput');
        const sendBtn = document.getElementById('sendBtn');
        const counter = document.getElementById('counter');
        const adminToggleBtn = document.getElementById('adminToggleBtn');
        const adminModal = document.getElementById('adminModal');
        const adminPassword = document.getElementById('adminPassword');
        const adminLoginBtn = document.getElementById('adminLoginBtn');
        const adminModalClose = document.getElementById('adminModalClose');
        const themeToggle = document.getElementById('themeToggle');
        const warning = document.getElementById('internet-warning');
        const muteModal = document.getElementById('muteModal');
        const muteInput = document.getElementById('muteInput');
        const muteConfirmBtn = document.getElementById('muteConfirmBtn');
        const muteModalClose = document.getElementById('muteModalClose');
        const rulesContainer = document.getElementById('rulesContainer');

        const STORAGE_KEY = 'terminal_chat_v13';
        const BANNED_KEY = 'terminal_banned_v13';
        const RULES_KEY = 'terminal_rules_v13';

        let isAdmin = false;
        const ADMIN_PASSWORD = 'admin123';
        let bannedList = [];
        let rulesText = '';

        // ==========================================
        // 2. ТЕМА
        // ==========================================
        function loadTheme() {
            const saved = localStorage.getItem('terminal_theme');
            if (saved === 'dark') {
                document.body.classList.add('dark-theme');
                themeToggle.textContent = '☀️';
            } else {
                document.body.classList.remove('dark-theme');
                themeToggle.textContent = '🌙';
            }
        }

        function toggleTheme() {
            document.body.classList.toggle('dark-theme');
            const isDark = document.body.classList.contains('dark-theme');
            themeToggle.textContent = isDark ? '☀️' : '🌙';
            localStorage.setItem('terminal_theme', isDark ? 'dark' : 'light');
        }
        themeToggle.addEventListener('click', toggleTheme);

        // ==========================================
        // 3. ПРОВЕРКА ИНТЕРНЕТА
        // ==========================================
        function checkInternet() {
            if (!navigator.onLine) {
                warning.classList.add('show');
            } else {
                warning.classList.remove('show');
            }
        }
        window.addEventListener('online', checkInternet);
        window.addEventListener('offline', checkInternet);
        setInterval(checkInternet, 3000);
        checkInternet();

        // ==========================================
        // 4. ЗАГРУЗКА БАН-ЛИСТА
        // ==========================================
        function loadBanned() {
            const stored = localStorage.getItem(BANNED_KEY);
            if (stored) {
                try {
                    bannedList = JSON.parse(stored);
                } catch (e) {
                    bannedList = [];
                }
            }
        }

        function saveBanned() {
            localStorage.setItem(BANNED_KEY, JSON.stringify(bannedList));
        }

        // ==========================================
        // 5. ЗАГРУЗКА ПРАВИЛ
        // ==========================================
        function loadRules() {
            const stored = localStorage.getItem(RULES_KEY);
            if (stored) {
                rulesText = stored;
                showRules();
            }
        }

        function saveRules(text) {
            localStorage.setItem(RULES_KEY, text);
            rulesText = text;
            showRules();
        }

        function showRules() {
            if (rulesText) {
                rulesContainer.style.display = 'block';
                const lines = rulesText.split('\n').filter(line => line.trim() !== '');
                rulesContainer.innerHTML = `
                        <div class="rules-box">
                            <h4>📋 ПРАВИЛА ЧАТА:</h4>
                            <ul>
                                ${lines.map(line => `<li>${line}</li>`).join('')}
                            </ul>
                        </div>
                    `;
            } else {
                rulesContainer.style.display = 'none';
            }
        }

        // ==========================================
        // 6. ЗАГРУЗКА СООБЩЕНИЙ
        // ==========================================
        function loadMessages() {
            const stored = localStorage.getItem(STORAGE_KEY);
            if (stored) {
                try {
                    const messages = JSON.parse(stored);
                    messages.forEach(msg => {
                        // Проверяем, не забанен ли автор
                        if (bannedList.includes(msg.nick)) {
                            addMessageToDOM('⚠️ ЗАБАНЕН', 'Этот пользователь забанен. Сообщение скрыто.', msg.time, msg.id,
                                true);
                            return;
                        }
                        addMessageToDOM(msg.nick, msg.text, msg.time, msg.id, false);
                    });
                } catch (e) {}
            }
        }

        // ==========================================
        // 7. ДОБАВЛЕНИЕ СООБЩЕНИЯ
        // ==========================================
        function addMessageToDOM(nick, text, time, id = null, isBanned = false) {
            const msgDiv = document.createElement('div');
            msgDiv.className = 'message';
            if (!id) id = Date.now() + '_' + Math.random().toString(36).substr(2, 6);
            msgDiv.dataset.id = id;

            const content = document.createElement('div');
            content.className = 'message-content';

            const timeSpan = document.createElement('span');
            timeSpan.className = 'time';
            timeSpan.textContent = time || getCurrentTime();

            const nickSpan = document.createElement('span');
            nickSpan.className = 'nick';
            nickSpan.textContent = isBanned ? '⚠️ ЗАБАНЕН' : (nick || 'Аноним');

            const textSpan = document.createElement('span');
            textSpan.className = 'text';
            textSpan.textContent = isBanned ? '⛔ Сообщение скрыто' : text;

            content.appendChild(timeSpan);
            content.appendChild(nickSpan);
            content.appendChild(textSpan);

            const deleteBtn = document.createElement('button');
            deleteBtn.className = 'delete-btn';
            deleteBtn.textContent = '✕';
            deleteBtn.title = 'Удалить (админ)';
            deleteBtn.style.display = isAdmin ? 'block' : 'none';
            deleteBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                deleteMessage(id);
            });

            msgDiv.appendChild(content);
            msgDiv.appendChild(deleteBtn);

            // Вставляем перед блоком правил (если он есть)
            if (rulesContainer.style.display !== 'none') {
                messageContainer.insertBefore(msgDiv, rulesContainer);
            } else {
                messageContainer.appendChild(msgDiv);
            }

            messageContainer.scrollTop = messageContainer.scrollHeight;
            updateCounter();
            return msgDiv;
        }

        // ==========================================
        // 8. УДАЛЕНИЕ
        // ==========================================
        function deleteMessage(id) {
            if (!isAdmin) {
                alert('Только админ может удалять сообщения!');
                return;
            }
            if (confirm('Удалить сообщение?')) {
                const stored = localStorage.getItem(STORAGE_KEY);
                if (stored) {
                    try {
                        let messages = JSON.parse(stored);
                        messages = messages.filter(msg => msg.id !== id);
                        localStorage.setItem(STORAGE_KEY, JSON.stringify(messages));
                    } catch (e) {}
                }
                const msgElements = document.querySelectorAll(`.message[data-id="${id}"]`);
                msgElements.forEach(el => el.remove());
                updateCounter();
            }
        }

        // ==========================================
        // 9. СОХРАНЕНИЕ СООБЩЕНИЯ
        // ==========================================
        function saveMessageToStorage(nick, text, time, id) {
            const stored = localStorage.getItem(STORAGE_KEY);
            let messages = [];
            if (stored) {
                try {
                    messages = JSON.parse(stored);
                } catch (e) {}
            }
            messages.push({ nick, text, time, id });
            if (messages.length > 500) messages = messages.slice(-500);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(messages));
        }

        // ==========================================
        // 10. ОТПРАВКА СООБЩЕНИЯ
        // ==========================================
        function sendMessage() {
            let nick = nickInput.value.trim() || 'Аноним';
            const text = msgInput.value.trim();

            // Проверка на бан
            if (bannedList.includes(nick)) {
                alert('❌ Вы забанены и не можете отправлять сообщения!');
                return;
            }

            if (!text) {
                msgInput.focus();
                return;
            }

            // Если это первое сообщение админа — запрашиваем правила
            if (isAdmin && text.startsWith('/rules')) {
                const rulesText = text.replace('/rules', '').trim();
                if (rulesText) {
                    saveRules(rulesText);
                    msgInput.value = '';
                    msgInput.focus();
                    return;
                } else {
                    alert('Напишите /rules [текст правил] (каждое правило с новой строки)');
                    return;
                }
            }

            // Если это команда на мьют (только админ)
            if (isAdmin && text.startsWith('/mute')) {
                const targetNick = text.replace('/mute', '').trim();
                if (targetNick) {
                    muteUser(targetNick);
                    msgInput.value = '';
                    msgInput.focus();
                    return;
                } else {
                    alert('Напишите /mute [ник]');
                    return;
                }
            }

            // Если это команда на размьют (только админ)
            if (isAdmin && text.startsWith('/unmute')) {
                const targetNick = text.replace('/unmute', '').trim();
                if (targetNick) {
                    unmuteUser(targetNick);
                    msgInput.value = '';
                    msgInput.focus();
                    return;
                } else {
                    alert('Напишите /unmute [ник]');
                    return;
                }
            }

            // Обычное сообщение
            const id = Date.now() + '_' + Math.random().toString(36).substr(2, 6);
            const time = getCurrentTime();

            addMessageToDOM(nick, text, time, id);
            saveMessageToStorage(nick, text, time, id);

            msgInput.value = '';
            msgInput.focus();

            // Если это первое сообщение от админа и правил ещё нет — активируем правила
            if (isAdmin && !rulesText) {
                setTimeout(() => {
                    const answer = confirm(
                    '📋 Вы администратор. Хотите установить правила чата? Напишите их в следующем окне (каждое правило с новой строки).');
                    if (answer) {
                        const rules = prompt('Введите правила чата (каждое правило с новой строки):');
                        if (rules && rules.trim()) {
                            saveRules(rules.trim());
                        }
                    }
                }, 500);
            }
        }

        // ==========================================
        // 11. МЬЮТ (БАН)
        // ==========================================
        function muteUser(nick) {
            if (!isAdmin) {
                alert('Только админ может выдавать мьют!');
                return;
            }
            if (!nick) return;
            if (bannedList.includes(nick)) {
                alert(`Пользователь ${nick} уже забанен.`);
                return;
            }
            bannedList.push(nick);
            saveBanned();
            alert(`✅ Пользователь ${nick} забанен!`);
            // Обновляем сообщения (скрываем сообщения забаненного)
            refreshMessages();
        }

        function unmuteUser(nick) {
            if (!isAdmin) {
                alert('Только админ может снимать мьют!');
                return;
            }
            if (!nick) return;
            if (!bannedList.includes(nick)) {
                alert(`Пользователь ${nick} не в бане.`);
                return;
            }
            bannedList = bannedList.filter(n => n !== nick);
            saveBanned();
            alert(`✅ Пользователь ${nick} разбанен!`);
            refreshMessages();
        }

        function refreshMessages() {
            // Очищаем сообщения (кроме истории и правил)
            const messages = messageContainer.querySelectorAll('.message');
            messages.forEach(el => el.remove());
            // Перезагружаем
            loadMessages();
            updateCounter();
        }

        // ==========================================
        // 12. СЧЁТЧИК
        // ==========================================
        function updateCounter() {
            const count = messageContainer.querySelectorAll('.message').length;
            let word = 'сообщений';
            if (count % 10 === 1 && count % 100 !== 11) word = 'сообщение';
            else if (count % 10 >= 2 && count % 10 <= 4 && (count % 100 < 10 || count % 100 >= 20)) word = 'сообщения';
            counter.textContent = `${count} ${word}`;
        }

        // ==========================================
        // 13. ВРЕМЯ
        // ==========================================
        function getCurrentTime() {
            const now = new Date();
            return String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');
        }

        // ==========================================
        // 14. АДМИН
        // ==========================================
        function toggleAdminMode() {
            if (isAdmin) {
                isAdmin = false;
                adminToggleBtn.textContent = '🔑 Админ';
                adminToggleBtn.classList.remove('active');
                document.querySelectorAll('.delete-btn').forEach(btn => btn.style.display = 'none');
                // Убираем кнопку мьюта
                const muteBtn = document.getElementById('muteBtn');
                if (muteBtn) muteBtn.remove();
            } else {
                adminModal.style.display = 'flex';
                adminPassword.value = '';
                adminPassword.focus();
            }
        }

        function loginAdmin() {
            if (adminPassword.value === ADMIN_PASSWORD) {
                isAdmin = true;
                adminToggleBtn.textContent = '🚪 Выйти';
                adminToggleBtn.classList.add('active');
                document.querySelectorAll('.delete-btn').forEach(btn => btn.style.display = 'block');
                adminModal.style.display = 'none';
                alert('✅ Вы вошли как администратор!');
                showMuteButton();
            } else {
                alert('❌ Неверный пароль!');
                adminPassword.value = '';
                adminPassword.focus();
            }
        }

        function showMuteButton() {
            if (!document.getElementById('muteBtn')) {
                const muteBtn = document.createElement('button');
                muteBtn.id = 'muteBtn';
                muteBtn.className = 'admin-btn';
                muteBtn.textContent = '🔇 Мьют';
                muteBtn.style.marginLeft = '5px';
                muteBtn.addEventListener('click', () => {
                    muteModal.style.display = 'flex';
                    muteInput.value = '';
                    muteInput.focus();
                });
                const headerRight = document.querySelector('.header-right');
                headerRight.appendChild(muteBtn);
            }
        }

        // ==========================================
        // 15. СОБЫТИЯ
        // ==========================================
        sendBtn.addEventListener('click', sendMessage);
        msgInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') { e.preventDefault();
                sendMessage(); }
        });
        nickInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') msgInput.focus();
